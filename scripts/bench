#!/usr/bin/env bash
# Entry point for the benchmark orchestrator (scripts/benchctl).
# Uses the project virtualenv created by `make setup` when present.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${ROOT}/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
export PYTHONPATH="${ROOT}/scripts${PYTHONPATH:+:${PYTHONPATH}}"
exec "$PY" -m benchctl "$@"
